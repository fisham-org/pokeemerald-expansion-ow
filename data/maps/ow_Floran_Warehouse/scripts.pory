mapscripts ow_Floran_Warehouse_MapScripts {}

// ==========================================
// ow_Floran_Warehouse NPCs
// ==========================================

script ow_Floran_Warehouse_EventScript_Foreman {
    lock
    faceplayer
    msgbox(format("Watch yourself near the conveyor.\NLast thing I need is a trainer caught in the rollers."))
    release
    end
}

script ow_Floran_Warehouse_EventScript_Lumberjack {
    lock
    faceplayer
    msgbox(format("Good lumber needs a clean cut or it warps in the dry season.\NScyther gets that. Took about a day to train."))
    release
    end
}

script ow_Floran_Warehouse_EventScript_Manager {
    lock
    faceplayer
    msgbox(format("Is the belt running? It sounds like the belt's running.\NSomeone should check if the belt's running."))
    release
    end
}

script ow_Floran_Warehouse_EventScript_Axew {
    lock
    faceplayer
    playmoncry(SPECIES_AXEW, CRY_MODE_NORMAL)
    waitmoncry
    msgbox(format("The Axew stops and looks up at you, a wood chip stuck to its snout."))
    release
    end
}

script ow_Floran_Warehouse_EventScript_Scyther {
    lock
    playmoncry(SPECIES_SCYTHER, CRY_MODE_NORMAL)
    waitmoncry
    msgbox(format("The Scyther's blades flash and a log splits clean down the middle. It doesn't look up."))
    release
    end
}
