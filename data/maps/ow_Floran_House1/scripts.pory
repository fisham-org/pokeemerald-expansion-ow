script ow_Floran_House1_EventScript_BoatBuilder {
    lock
    faceplayer
    msgbox(format("Floran runs on boats, and the best of them come from one workshop.\pGym leader and boatwright - same hands. Sources her own timber, builds every piece herself.\pThat kind of care is rare."))
    release
    end
}
