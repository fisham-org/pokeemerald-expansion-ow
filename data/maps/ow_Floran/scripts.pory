    msgbox(format("They say the executives run everything from the top floor.\pNone of them ever come down to the lumberyard.\pIt must be a different world up there."))
    release
    end
}

// ============================================================
// PIER FISHERMAN (pollution) - LOCALID_FLORAN_PIER_FISHERMAN
// ============================================================

script ow_Floran_EventScript_PierFisherman {
    lock
    faceplayer
    msgbox(format("I've been fishing this river for twenty years.\pSomething's off with the water now.\NI won't say it's the warehouse for certain, but it probably has something to do with it."))
    release
    end
}

