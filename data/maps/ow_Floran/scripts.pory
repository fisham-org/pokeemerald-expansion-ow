// RUNNER F (with Pokemon) - LOCALID_FLORAN_RUNNER_F
// ============================================================

script ow_Floran_EventScript_RunnerF {
    lock
    faceplayer
    msgbox(format("My Floatzel keeps pace with me on the river stretch.\pI can't shake it... not that I'm trying very hard."))
    release
    end
}

// ============================================================
// NORTH FISHERMAN (runners) - LOCALID_FLORAN_NORTH_FISHERMAN
// ============================================================

script ow_Floran_EventScript_NorthFisherman {
    lock
    faceplayer
    msgbox(format("Those runners thunder back and forth all day.\pDrives the water Pokemon straight down to the riverbed."))
    release
    end
}

// ============================================================
// HONEY WOMAN (one-off trade) - LOCALID_FLORAN_HONEY_WOMAN
// ============================================================

script ow_Floran_EventScript_HoneyWoman {
    lock
    faceplayer
    goto_if_set(FLAG_FLORAN_HONEY_TRADE_DONE, ow_Floran_EventScript_HoneyWoman_Done)
    msgbox(format("There used to be a beehive just here.\pThe Combee are gone now - the noise drove them off.\NThis end of town smells of sawdust instead of flowers."))
    checkitem(ITEM_HONEY, 1)
    goto_if_eq(VAR_RESULT, FALSE, ow_Floran_EventScript_HoneyWoman_NoHoney)
    msgbox(format("Hmm, that smell! Is that honey? I haven't seen a jar like that since the apiary moved south..."))
    msgbox(format("Would you part with it?\NI have a Silver Powder I'd trade you for it."), MSGBOX_YESNO)
    goto_if_eq(VAR_RESULT, NO, ow_Floran_EventScript_HoneyWoman_Declined)
    removeitem(ITEM_HONEY, 1)
    giveitem(ITEM_SILVER_POWDER, 1)
    setflag(FLAG_FLORAN_HONEY_TRADE_DONE)
    msgbox(format("Thank you.\pThat's what this whole town used to smell like."))
    release
    end
}

script ow_Floran_EventScript_HoneyWoman_NoHoney {
    msgbox(format("If you ever find some honey from down the southern route, come find me.\NI might have something worth trading."))
    release
    end
}

script ow_Floran_EventScript_HoneyWoman_Declined {
    msgbox(format("That's ok."))
    release
    end
}

script ow_Floran_EventScript_HoneyWoman_Done {
    msgbox(format("Thank you again for the honey. I still miss the Combee, though."))
    release
    end
}

