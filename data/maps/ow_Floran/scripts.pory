// ============================================================
// LUMBERYARD SAILOR - LOCALID_FLORAN_LUMBERYARD_SAILOR
// ============================================================

script ow_Floran_EventScript_LumberyardSailor {
    lock
    faceplayer
    msgbox(format("I'm supposed to be observing the Farfetch'd. But the Sirfetch'd does a good enough job by itself - it runs a tight ship! Ha ha!"))
    release
    end
}

// ============================================================
// LONELY COMBEE (gated on QUEST_HONEY) - LOCALID_FLORAN_LONELY_COMBEE
// ============================================================

script ow_Floran_EventScript_LonelyCombee {
    lock
    faceplayer
    goto_if_quest_complete(QUEST_HONEY, ow_Floran_EventScript_LonelyCombee_QuestDone)
    playmoncry(SPECIES_COMBEE, CRY_MODE_NORMAL)
    waitmoncry
    msgbox(format("The Combee hovers in slow circles around the old hive frame.\NIts hum is low and uncertain."))
    release
    end
}

script ow_Floran_EventScript_LonelyCombee_QuestDone {
    playmoncry(SPECIES_COMBEE, CRY_MODE_NORMAL)
    waitmoncry
    msgbox(format("The Combee turns toward you as you approach.\NSomething in its hum shifts."))
    msgbox(format("The old hive is empty. The apiary on the southern route is full and alive.\pDirect the Combee south?"), MSGBOX_YESNO)
    goto_if_eq(VAR_RESULT, NO, ow_Floran_EventScript_LonelyCombee_Stay)
    applymovement(LOCALID_FLORAN_LONELY_COMBEE, ow_Floran_Movement_CombeeLeave)
    waitmovement(0)
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_FLORAN_LONELY_COMBEE)
    setflag(FLAG_HIDE_FLORAN_LONELY_COMBEE)
    fadescreen(FADE_FROM_BLACK)
    msgbox(format("The Combee turns south and flies off toward the forest route."))
    release
    end
}

script ow_Floran_EventScript_LonelyCombee_Stay {
    msgbox(format("The Combee resumes its slow orbit of the empty frame."))
    release
    end
}

movement ow_Floran_Movement_CombeeLeave {
    emote_heart
    delay_16
    step_end
}

