mapscripts ow_Floran_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ow_Floran_OnTransition
}

script ow_Floran_OnTransition {
    setflag(FLAG_VISITED_FLORAN)
    end
}

// ============================================================
// TOWNSMAN (south end, worker housing) - LOCALID_FLORAN_TOWNSMAN
// ============================================================

script ow_Floran_EventScript_Townsman {
    lock
    faceplayer
    msgbox(format("Most of the folk who live up this end don't work for Westmark.\pWhen the warehouse expanded, they built new houses for their new employees who moved here."))
    release
    end
}

// ============================================================
// BOARDWALK MAN - LOCALID_FLORAN_BOARDWALK_MAN
// ============================================================

script ow_Floran_EventScript_BoardwalkMan {
    lock
    faceplayer
    msgbox(format("On windy days, the sawdust drifts all the way up to the boardwalk.\NYou can practically taste it, if the wind's right."))
    release
    end
}

// ============================================================
// GYM GARDEN MAN (comments on Vesna) - LOCALID_FLORAN_GYM_GARDEN_MAN
// ============================================================

script ow_Floran_EventScript_GymGardenMan {
    lock
    faceplayer
    msgbox(format("You see this garden beside the gym?"))
    applymovement(LOCALID_FLORAN_GYM_GARDEN_MAN, moves(face_up))
    waitmovement
    msgbox(format("Vesna planted every one of those herself.\NSame way she works the wood - nothing rushed, nothing wasted."))
    release
    end
}

// ============================================================
// HQ RUMOURS WOMAN - LOCALID_FLORAN_HQ_RUMOURS_WOMAN
// ============================================================

script ow_Floran_EventScript_HQRumoursWoman {
    lock
