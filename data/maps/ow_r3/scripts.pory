mapscripts ow_r3_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ow_r3_OnTransition
}

// Syncs survey blocker / surveyor trainer visibility with VAR_CULTURE_STATE on every map entry.
// Blockers are visible (flags clear) until phase 1 is done (state >= 4).
// Surveyor trainer is hidden (flag set) until then.
script ow_r3_OnTransition {
    goto_if_ge(VAR_CULTURE_STATE, 4, ow_r3_OnTransition_QuestDone)
    setflag(FLAG_HIDE_OW_R3_SURVEYOR_TRAINER)
    clearflag(FLAG_HIDE_OW_R3_SURVEYOR_BLOCK_1)
    clearflag(FLAG_HIDE_OW_R3_SURVEYOR_BLOCK_2)
    clearflag(FLAG_HIDE_OW_R3_SURVEYOR_BLOCK_3)
    clearflag(FLAG_HIDE_OW_R3_SURVEYOR_BLOCK_4)
    end
}

script ow_r3_OnTransition_QuestDone {
    clearflag(FLAG_HIDE_OW_R3_SURVEYOR_TRAINER)
    setflag(FLAG_HIDE_OW_R3_SURVEYOR_BLOCK_1)
    setflag(FLAG_HIDE_OW_R3_SURVEYOR_BLOCK_2)
    setflag(FLAG_HIDE_OW_R3_SURVEYOR_BLOCK_3)
    setflag(FLAG_HIDE_OW_R3_SURVEYOR_BLOCK_4)
    end
}

// ============================================================
// WOODCUTTERS (Westmark crew, cut-site cabin area)
// ============================================================

script ow_r3_EventScript_Woodcutter1 {
    trainerbattle_single(TRAINER_OW_R3_WOODCUTTER_1, format("You're not from Westmark. Doesn't matter - you'll learn to respect the crew."), format("...You have a steady hand."))
    msgbox(format("We do what we do.\NThe trees were going one way or another."))
    release
    end
}

script ow_r3_EventScript_Woodcutter2 {
    trainerbattle_single(TRAINER_OW_R3_WOODCUTTER_2, format("Huh, a battle? Aye, I can take a break."), format("Aye. Fair enough."))
    msgbox(format("Doesn't sit right with me either,\Nif I'm being straight about it.\pBut I've got mouths to feed."))
    release
    end
}

// ============================================================
// POND (Child + Bidoof companion)
// ============================================================

script ow_r3_EventScript_PondChild {
    lock
    faceplayer
    msgbox(format("Bidoof doesn't care about the stumps.\pHe just finds the biggest puddle and dives in.\pI tried telling him that's not how ponds work."))
    release
    end
}

script ow_r3_EventScript_Bidoof {
    lock
    faceplayer
    playmoncry(SPECIES_BIDOOF, 0)
    waitmoncry
    release
    end
}

// ============================================================
// PAINTER (party colour challenge)
// ============================================================

script ow_r3_EventScript_Painter {
    lock
    faceplayer
    goto_if_set(FLAG_RECEIVED_R3_PAINTER_REWARD, ow_r3_EventScript_Painter_AlreadyGave)
    msgbox(format("I came here to paint the western coast.\pRed flowers, blue sea, yellow sands, the whole palette in one place.\NIf you've got Pokémon that match those colours, bring them over.\NI want to see how it all sits together."))
    specialvar(VAR_RESULT, CheckPartyHasRGBPokemon)
    goto_if_eq(VAR_RESULT, 0, ow_r3_EventScript_Painter_NotReady)
    msgbox(format("Yes! That's exactly it.\pThe contrast - it's everything.\NHere - take this. You've got an eye for composition."))
    giveitem(ITEM_POKE_DOLL)
    goto_if_eq(VAR_RESULT, 0, ow_r3_EventScript_Painter_BagFull)
    setflag(FLAG_RECEIVED_R3_PAINTER_REWARD)
    release
    end
}

script ow_r3_EventScript_Painter_NotReady {
    msgbox(format("Not quite - I need red, blue, and yellow\Nin your party. Three Pokémon, three colours."))
    release
    end
}

script ow_r3_EventScript_Painter_BagFull {
    msgbox(format("Looks like you've got no room.\NCome back when you do."))
    release
    end
}

script ow_r3_EventScript_Painter_AlreadyGave {
    msgbox(format("You have good taste.\NNot everyone would stop here."))
    release
    end
}

// ============================================================
// BEACH (family scene - tuber, sailor, mother, father, child)
// ============================================================

script ow_r3_EventScript_TuberBeachboy {
    trainerbattle_single(TRAINER_OW_R3_TUBER_MATTEO, format("Race you to the waterline!"), format("Ugh! You're so fast!"))
    msgbox(format("You might even be better than daddy!"))
    release
    end
}

script ow_r3_EventScript_BeachMother {
    lock
    faceplayer
    msgbox(format("Matteo! Don't go past where I can see you!\p...Sorry. We try to get out of the city on weekends.\NOur kids enjoy the gentle waves here."))
    release
    end
}

script ow_r3_EventScript_BeachFather {
    trainerbattle_single(TRAINER_OW_R3_BEACH_FATHER, format("Kids! Watch this.\pThis is what a proper Pokémon battle looks like!"), format("...We don't need to mention this part."))
    msgbox(format("Right. Uhh...\pThey saw nothing."))
    release
    end
}

script ow_r3_EventScript_BeachChild {
    lock
    faceplayer
    msgbox(format("The water's freezing but dad says\Nthat's just because we're not tough enough yet!\pHe went in up to his ankles\Nand made a very loud noise."))
    release
    end
}

script ow_r3_EventScript_Sailor {
    trainerbattle_single(TRAINER_OW_R3_SAILOR, format("I've run this coast enough times to know a rookie from a vet.\pYou're no sailor. Let's see what you are."), format("Hah! Good eye."))
    msgbox(format("Used to be almost impossible to get to Kolchavi without a boat or Pokemon to carry you.\NIt's a bit easier now."))
    release
    end
}

// ============================================================
// BATTLE REWARDER (cliff split near r6 junction)
// ============================================================

script ow_r3_EventScript_BattleRewarder {
    lock
    faceplayer
    goto_if_set(FLAG_RECEIVED_R3_MYSTIC_WATER, ow_r3_EventScript_BattleRewarder_Already)
    setvar(VAR_TEMP_0, 0)
    if (defeated(TRAINER_OW_R3_WOODCUTTER_1) == TRUE) {
        addvar(VAR_TEMP_0, 1)
    }
    if (defeated(TRAINER_OW_R3_WOODCUTTER_2) == TRUE) {
        addvar(VAR_TEMP_0, 1)
    }
    if (defeated(TRAINER_OW_R3_TUBER_MATTEO) == TRUE) {
        addvar(VAR_TEMP_0, 1)
    }
    if (defeated(TRAINER_OW_R3_SAILOR) == TRUE) {
        addvar(VAR_TEMP_0, 1)
    }
    if (defeated(TRAINER_OW_R3_BEACH_FATHER) == TRUE) {
        addvar(VAR_TEMP_0, 1)
    }
    goto_if_lt(VAR_TEMP_0, 4, ow_r3_EventScript_BattleRewarder_NotDone)
    msgbox(format("Now that's a full route sweep.\pHere - Mystic Water. There's plenty of sea\Nin view up here. Might as well put it to use."))
    giveitem(ITEM_MYSTIC_WATER)
    goto_if_eq(VAR_RESULT, 0, ow_r3_EventScript_BattleRewarder_BagFull)
    setflag(FLAG_RECEIVED_R3_MYSTIC_WATER)
    release
    end
}

script ow_r3_EventScript_BattleRewarder_NotDone {
    msgbox(format("This stretch has good trainers on it\Nif you know where to look.\pTest yourself against all of them,\Nthen come find me again."))
    release
    end
}

script ow_r3_EventScript_BattleRewarder_BagFull {
    msgbox(format("Looks like you've got no room.\NCome back when you do."))
    release
    end
}

script ow_r3_EventScript_BattleRewarder_Already {
    msgbox(format("The view from here pays for itself, I think."))
    release
    end
}

// ============================================================
// SURVEY BLOCKERS (west)
// ============================================================

script ow_r3_EventScript_SurveyorBlock1 {
    lock
    faceplayer
    msgbox(format("Westmark is surveying this upper area.\pCome back once the report's filed.\NOtherwise, you can go through the cave."))
    release
    end
}

script ow_r3_EventScript_SurveyorBlock2 {
    lock
    faceplayer
    msgbox(format("We can't let you through. The survey's still running up there.\pWestmark's job, not mine to explain.\NJust keeping the path clear."))
    release
    end
}

// ============================================================
// SURVEY BLOCKERS (east)
// ============================================================

script ow_r3_EventScript_SurveyorBlock3 {
    lock
    faceplayer
    msgbox(format("Survey zone. Upper shelf's off-limits\Ntill the assessment's done.\pGood timber up here. Hope they put\Nit to use."))
    release
    end
}

script ow_r3_EventScript_SurveyorBlock4 {
    lock
    faceplayer
    msgbox(format("Path's closed - we have a crew on the ridge doing measurements.\pYou might need to venture through Sowback Cave to get by."))
    release
    end
}

// ============================================================
// SURVEYOR TRAINER (hidden until VAR_CULTURE_STATE >= 4)
// ============================================================

script ow_r3_EventScript_SurveyorTrainer {
    trainerbattle_single(TRAINER_OW_R3_SURVEYOR, format("Didn't expect to find someone up here this late in the season.\pThe survey's done. I've got nothing to do but wait for Westmark to decide what to do with my findings."), format("Ha. I spend too much time with my instruments and not enough with my team."))
    msgbox(format("The data I gave them would extend the Haul Road\Nright through the lower ridge.\pWhether it gets built is someone else's\Nproblem now."))
    release
    end
}

// ============================================================
// BUG CATCHER (clifftop hunter)
// ============================================================

script ow_r3_EventScript_BugCatcher {
    trainerbattle_single(TRAINER_OW_R3_BUG_CATCHER, format("Be careful! Don't startle the Charjabugs!"), format("They scattered! You must have scared them all off!"))
    msgbox(format("Grubbin and Charjabug stay underground mostly.\NVikavolt are the ones to watch up in the air!"))
    release
    end
}
