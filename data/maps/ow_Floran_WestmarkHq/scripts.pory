mapscripts ow_Floran_WestmarkHq_MapScripts {}

// ============================================================
// RECEPTIONIST
// ============================================================

script ow_Floran_WestmarkHq_EventScript_Receptionist {
    lock
    faceplayer
    setspeaker("Receptionist")
    msgbox(format("Welcome to the headquarters of Westmark Logging Company.\pIf you are here for an appointment, please wait downstairs."))
    setspeaker(NULL)
    release
    end
}

// ============================================================
// JOB APPLICANT
// ============================================================

script ow_Floran_WestmarkHq_EventScript_Applicant {
    lock
    faceplayer
    setspeaker("Woman")
    msgbox(format("I've spent two years monitoring potential harvest sites in the field.\pI think I've earned a desk with a view."))
    setspeaker(NULL)
    release
    end
}

// ============================================================
// WAREHOUSE CONTRAST
// ============================================================

script ow_Floran_WestmarkHq_EventScript_WarehouseMan {
    lock
    faceplayer
    setspeaker("Man")
    msgbox(format("I spend most of my time on warehouse floor.\pCompared to this office, the two workplaces couldn't be more different."))
    setspeaker(NULL)
    release
    end
}

// ============================================================
// REPORT ANALYST
// ============================================================

script ow_Floran_WestmarkHq_EventScript_ReportAnalyst {
    lock
    faceplayer
    setspeaker("Woman")
    msgbox(format("I need these figures to reconcile before end of week.\pSorry - I don't have time to speak right now."))
    setspeaker(NULL)
    release
    end
}

// ============================================================
// SENIOR ANALYST
// ============================================================

script ow_Floran_WestmarkHq_EventScript_SeniorAnalyst {
    lock
    faceplayer
    setspeaker("Woman")
    msgbox(format("I've spent thirteen years spent working for this company.\NAnd still, the board went looking in Sinteri."))
    setspeaker(NULL)
    release
    end
}

// ============================================================
// LUMBER ANALYST
// ============================================================

script ow_Floran_WestmarkHq_EventScript_LumberAnalyst {
    lock
    faceplayer
    setspeaker("Man")
    msgbox(format("Output from the northern sites is up thirty percent on last quarter.\pThe numbers are correct.\NI just don't know how long that rate holds."))
    setspeaker(NULL)
    release
    end
}

// ============================================================
// LORENZ
// ============================================================

script ow_Floran_WestmarkHq_EventScript_Lorenz {
    lock
    faceplayer
    setspeaker("Lorenz")
    msgbox(format("Lorenz. Director of Westmark.\NCan I help you with something?"))
    setspeaker(NULL)
    dynmultipush("His role", 0)
    dynmultipush("Employees", 1)
    dynmultipush("Approach", 2)
    dynmultipush("Goodbye", 3)
    dynmultistack(0, 0, FALSE, 4, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
    switch (var(VAR_RESULT)) {
        case 0:
            setspeaker("Lorenz")
            msgbox(format("I moved here from Sinteri when the previous director retired. I'm three months in.\pThe board expects results, but they have aggressive expectations."))
            setspeaker(NULL)
        case 1:
            setspeaker("Lorenz")
            msgbox(format("There are two kinds of people here: those who know trees, and those who know numbers.\pBoth are necessary, but they clash all too frequently."))
            setspeaker(NULL)
        case 2:
            setspeaker("Lorenz")
            msgbox(format("The southern logging operation has measured quotas, staggered harvests.\pThe north is harder to manage. The land doesn't recover at the rate our projections assume.\pI'm working on it."))
            setspeaker(NULL)
        default:
    }
    release
    end
}

// ============================================================
// JUNIOR EMPLOYEE
// ============================================================

script ow_Floran_WestmarkHq_EventScript_JuniorEmployee {
    lock
    faceplayer
    setspeaker("Westmark Employee")
    msgbox(format("I've been trying to get five minutes with my manager all morning.\pShe's been finishing a report for two hours and counting."))
    setspeaker(NULL)
    release
    end
}
